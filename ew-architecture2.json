    "views": [
      {
        "id": "authoring-path",
        "label": "Authoring request path",
        "focus": [
          "author",
          "da-live",
          "da-nx",
          "da-admin"
        ],
        "note": "The author's browser loads da-live, built on the da-nx shell, and reads/writes content through da-admin."
      },
      {
        "id": "realtime-collab",
        "label": "Real-time collaboration",
        "focus": [
          "da-live",
          "da-collab",
          "da-admin"
        ],
        "note": "Concurrent editors sync over da-collab's Durable Objects, which persist back through da-admin."
      },
      {
        "id": "coworker-agent",
        "label": "CMA / CX Coworker agent",
        "focus": [
          "da-live",
          "coworker",
          "da-mcp",
          "da-admin"
        ],
        "note": "The chat-ao block in da-live/da-nx talks to Adobe's Agent Orchestrator (Coworker), which calls DA back through da-mcp's tool set."
      },
      {
        "id": "publishing",
        "label": "Publishing to Edge Delivery",
        "focus": [
          "da-admin",
          "storage",
          "da-content",
          "edge-delivery"
        ],
        "note": "Published content is served to production sites through da-content, which falls back to da-admin."
      }
    ],
    "legend": {
      "entries": {
        "database": {
          "label": "Storage"
        }
      }
    }
