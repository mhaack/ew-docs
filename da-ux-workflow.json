  "cards": [
    {
      "dot": "cyan",
      "title": "Authoring",
      "items": [
        "Browse opens either the Authoring canvas or a Sheet \u2014 both da-live blocks",
        "Sheet reuses da-title (same Preview/Publish toolbar as legacy edit)",
        "Login, App Shell, AI Assistant and Extensions are persistent da-nx framework chrome"
      ]
    },
    {
      "dot": "violet",
      "title": "AI + Governance",
      "items": [
        "chat.js picks nx-chat or nx-chat-ao \u2014 chat-ao talks to CMA/CX Coworker over MCP as its backend",
        "Preflight only gates the Authoring path; Sheet publishes directly, no AI, no governance",
        "Preview and Publish share one utility: aemAction()/saveToAem() \u2192 nx2 api.js"
      ]
    }
  ]
